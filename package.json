{
  "name": "ivory37-control-laboral",
  "version": "3.2.3",
  "private": true,
  "description": "工V龱尺ㄚ㇌7 — control laboral",
  "main": "desktop/main.cjs",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --x64",
    "dist:win:setup": "electron-builder --win nsis --x64",
    "dist:win:portable": "electron-builder --win portable --x64"
  },
  "devDependencies": {
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.ivory37.controllaboral.desktop",
    "productName": "工V龱尺ㄚ㇌7",
    "directories": {
      "buildResources": "desktop/assets",
      "output": "desktop-dist"
    },
    "files": [
      "desktop/main.cjs",
      "desktop/preload.cjs",
      "desktop/assets/icon.ico",
      "index.html",
      "supabase-config.js",
      "supabase-sync.js",
      "vendor/supabase.js",
      "vendor/SUPABASE-LICENSE.txt",
      "manifest.json",
      "sw.js",
      "icon-192.png",
      "icon-512.png",
      "icon-512-maskable.png",
      "assets/ivory37-logo.jpg"
    ],
    "win": {
      "icon": "desktop/assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "工V龱尺ㄚ㇌7"
    }
  }
}
