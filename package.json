{
  "name": "ivory37-control-laboral",
  "version": "3.3.3",
  "private": true,
  "description": "Control Laboral — jornadas, horas extra, viajes y nóminas",
  "main": "desktop/main.cjs",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --x64",
    "dist:win:setup": "electron-builder --win nsis --x64",
    "dist:win:portable": "electron-builder --win portable --x64",
    "test": "node --test tests/*.test.cjs",
    "check:syntax": "node --check app.js && node --check rates.js && node --check calendar.js && node --check reports.js && node --check pwa.js && node --check spotlight.js && node --check supabase-config.js && node --check supabase-sync.js && node --check sw.js",
    "check": "npm run check:syntax && npm test"
  },
  "devDependencies": {
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.ivory37.controllaboral.desktop",
    "productName": "Control Laboral",
    "directories": {
      "buildResources": "desktop/assets",
      "output": "desktop-dist"
    },
    "files": [
      "desktop/main.cjs",
      "desktop/preload.cjs",
      "desktop/assets/icon.ico",
      "index.html",
      "app.js",
      "rates.js",
      "calendar.js",
      "reports.js",
      "pwa.js",
      "spotlight.js",
      "supabase-config.js",
      "supabase-sync.js",
      "vendor/supabase.js",
      "vendor/SUPABASE-LICENSE.txt",
      "manifest.json",
      "sw.js",
      "icon-192.png",
      "icon-512.png",
      "icon-512-maskable.png",
      "brand-icon.svg",
      "assets/ivory37-logo.jpg"
    ],
    "win": {
      "icon": "desktop/assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Control Laboral"
    }
  }
}
