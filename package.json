{
  "name": "ivory37-control-laboral",
  "version": "3.3.23",
  "private": true,
  "description": "Control Laboral — jornadas, horas extra, viajes y nóminas",
  "main": "desktop/main.cjs",
  "scripts": {
    "start": "electron .",
    "sync:android": "node scripts/sync-android.cjs",
    "test:ui": "electron scripts/qa-ui.cjs",
    "dist:win": "electron-builder --win nsis --x64",
    "dist:win:setup": "electron-builder --win nsis --x64",
    "test": "node --test tests/*.test.cjs",
    "check:syntax": "node --check app.js && node --check rates.js && node --check calendar.js && node --check reports.js && node --check work-hours.js && node --check backup-tools.js && node --check theme-tools.js && node --check overtime-tools.js && node --check pwa.js && node --check spotlight.js && node --check supabase-config.js && node --check supabase-sync.js && node --check sw.js && node --check desktop/main.cjs && node --check desktop/preload.cjs && node --check storage.js && node --check privacy.js && node --check updates.js",
    "check": "npm run check:syntax && npm test",
    "test:reliability": "electron scripts/qa-reliability.cjs"
  },
  "devDependencies": {
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.ivory37.controllaboral.desktop",
    "productName": "Control Laboral",
    "directories": {
      "buildResources": "desktop/assets",
      "output": "desktop-dist"
    },
    "files": [
      "desktop/main.cjs",
      "desktop/preload.cjs",
      "desktop/assets/icon.ico",
      "index.html",
      "app.js",
      "rates.js",
      "calendar.js",
      "reports.js",
      "work-hours.js",
      "backup-tools.js",
      "theme-tools.js",
      "overtime-tools.js",
      "pwa.js",
      "spotlight.js",
      "supabase-config.js",
      "supabase-sync.js",
      "vendor/supabase.js",
      "vendor/SUPABASE-LICENSE.txt",
      "manifest.json",
      "sw.js",
      "icon-192.png",
      "icon-512.png",
      "icon-512-maskable.png",
      "brand-icon.svg",
      "assets/ivory37-logo.jpg",
      "storage.js",
      "privacy.js",
      "updates.js",
      "aurora-ui.css"
    ],
    "win": {
      "icon": "desktop/assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Control Laboral"
    }
  },
  "overrides": {
    "minimatch@>=7.0.0 <11.0.1": "11.0.6"
  },
  "author": "工V龱尺ㄚ㇌7"
}
